# Pin the public npm registry for this project.
#
# Without this, a contributor whose global ~/.npmrc points at a private
# registry (a corporate Artifactory mirror, for example) resolves packages
# through it, and npm writes those internal URLs into package-lock.json. That
# leaks the host into a public repository and breaks `npm ci` for everyone
# else, since the mirror is unreachable outside that network.
registry=https://registry.npmjs.org/
